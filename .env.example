# Copy this file to .env and paste your key in.
#   cp .env.example .env
#
# Get a key from https://aistudio.google.com/apikey
#
# The app tries gemini-3.5-flash-lite first, then falls back in order to
# gemini-3.1-flash-lite, gemini-2.5-flash-lite and gemini-2.5-flash if a
# model is rate-limited or erroring, and finally to the built-in offline
# parser if none of them responds.
#
# NOTE: .env is fetched by the browser at runtime, so the static server
# serves it to anyone who can reach it. Fine for local testing; do NOT
# use this path for a kiosk on a shared network — use the in-app API KEY
# modal (stored in localStorage) instead.
GEMINI_API_KEY=your_api_key_here
